---
import { NAP, SERVICE_AREAS } from '~/lib/nap';
import '@fontsource-variable/inter';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Open Graph / social share -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={NAP.name} />
  <meta property="og:image" content={`${NAP.url}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${NAP.name} — Fenham, ${NAP.phone.display}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${NAP.url}/og-image.png`} />

  <slot name="head" />
</head>
<body>

<header class="site-header">
  <div class="inner">
    <a href="/" class="logo" aria-label={NAP.name}>
      <img src="/newcastle-logo.svg" alt="" width="28" height="34" style="vertical-align:middle" />
      Newcastle <span>Oven Cleaning</span>
    </a>
    <nav class="desktop-nav">
      <a href="/#services">Services</a>
      <a href="/#areas">Areas</a>
      <a href="/pricing/">Pricing</a>
      <a href="/about/">About</a>
      <a href={NAP.phone.href} class="nav-cta" aria-label={`Call ${NAP.phone.display}`}>📞 {NAP.phone.display}</a>
    </nav>

    <!-- Mobile-only header right side: phone CTA always visible + hamburger -->
    <div class="mobile-header-right">
      <a href={NAP.phone.href} class="mobile-phone-mini" aria-label={`Call ${NAP.phone.display}`}>📞</a>
      <button id="burger" class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <a href="/#services">Services</a>
    <a href="/#areas">Areas</a>
    <a href="/pricing/">Pricing</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
    <a href={NAP.phone.href} class="mobile-menu-call" aria-label={`Call ${NAP.phone.display}`}>📞 Call {NAP.phone.display}</a>
  </div>
</header>

<!-- TRUST STRIP — sitewide, just below header -->
<div class="trust-strip" role="complementary" aria-label="Business credentials">
  <span>Owner-run from Fenham</span><span class="sep">·</span>
  <span>Fully insured £1m</span><span class="sep">·</span>
  <span>{NAP.hours.display}</span>
</div>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="inner">
    <div class="logo">Newcastle <span>Oven Cleaning</span></div>
    <div class="contact">
      <a href={NAP.phone.href}>{NAP.phone.display}</a>
      <a href={NAP.email.href}>{NAP.email.address}</a>
    </div>
    <div class="areas">
      Serving: {SERVICE_AREAS.map((a, i) => (
        <>
          <a href={`/oven-cleaning-${a.slug}/`}>{a.name}</a>{i < SERVICE_AREAS.length - 1 ? ' · ' : ''}
        </>
      ))}
    </div>
    <div class="bottom">
      &copy; {year} {NAP.name} &middot; {NAP.legalName} &middot; {NAP.address.city}, {NAP.address.region}
    </div>
  </div>
</footer>

<!-- STICKY MOBILE CALL CTA — visible <1024px viewport only -->
<a
  href={NAP.phone.href}
  class="mobile-call-cta"
  aria-label={`Call Ross on ${NAP.phone.display}`}
>
  📞 Call Ross — <span class="num">{NAP.phone.display}</span>
</a>

<a
  href={NAP.whatsapp.link}
  class="wa-float"
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp Ross"
>
  <svg viewBox="0 0 32 32" fill="white" width="30" height="30" aria-hidden="true">
    <path d="M16 0C7.16 0 0 7.16 0 16c0 2.82.74 5.47 2.04 7.78L0 32l8.4-2.2A15.93 15.93 0 0 0 16 32c8.84 0 16-7.16 16-16S24.84 0 16 0zm0 29.33c-2.4 0-4.66-.65-6.61-1.79l-.47-.28-4.93 1.29 1.32-4.81-.31-.5A13.27 13.27 0 0 1 2.67 16C2.67 8.65 8.65 2.67 16 2.67S29.33 8.65 29.33 16 23.35 29.33 16 29.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.91.2s-1.04 1.3-1.28 1.57c-.24.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-2-2.37-2.23-2.77-.23-.4-.02-.62.18-.82.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.91-2.19-1.25-3-.33-.79-.66-.68-.91-.69h-.78c-.27 0-.7.1-1.07.5-.37.4-1.41 1.38-1.41 3.36s1.45 3.9 1.65 4.17c.2.27 2.85 4.36 6.92 6.11.97.42 1.72.67 2.31.86.97.31 1.85.27 2.55.16.78-.12 2.37-.97 2.7-1.9.34-.94.34-1.74.24-1.91-.1-.17-.37-.27-.77-.47z"/>
  </svg>
</a>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(function (q) {
    q.addEventListener('click', function () {
      q.parentElement?.classList.toggle('open');
    });
  });

  // Mobile burger menu toggle
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  if (burger && menu) {
    burger.addEventListener('click', function () {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      if (open) {
        menu.removeAttribute('hidden');
      } else {
        menu.setAttribute('hidden', '');
      }
    });
    // Close on link tap (so anchor links work)
    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        menu.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('hidden', '');
      });
    });
  }
</script>
</body>
</html>
