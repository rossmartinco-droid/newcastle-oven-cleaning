---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
  title?: string;
  sub?: string;
}

const { faqs, title = 'Frequently Asked Questions', sub } = Astro.props;
---
<section class="faq" id="faq">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    {sub && <p class="section-sub">{sub}</p>}
    <div class="faq-list">
      {faqs.map(f => (
        <div class="faq-item">
          <div class="faq-question">{f.question}</div>
          <div class="faq-answer" set:html={f.answer} />
        </div>
      ))}
    </div>
  </div>
</section>
