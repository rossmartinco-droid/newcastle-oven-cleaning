---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LocalBusiness from '~/components/schema/LocalBusiness.astro';
import Person from '~/components/schema/Person.astro';
import BreadcrumbList from '~/components/schema/BreadcrumbList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { NAP } from '~/lib/nap';

const title = 'About Newcastle Oven Cleaning | Ross Smith, Sole Trader, Fenham';
const description = 'Newcastle Oven Cleaning is run by Ross Smith — independent sole trader based in Fenham, Newcastle. Fully insured (£1m via Simply Business). Specialist oven cleaning only. Honest about Aga limits.';
const url = '/about/';
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <LocalBusiness />
    <Person sameAs={[]} />
    <BreadcrumbList crumbs={[{ name: 'About', url }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow">📍 Fenham, Newcastle upon Tyne</div>
      <h1>About <span>Newcastle Oven Cleaning</span></h1>
      <p class="hero-lead">
        Newcastle Oven Cleaning is run by Ross Smith — sole trader, owner-operator, no employees, no franchise overhead. Based at 60 Brighton Grove in Fenham, working across Newcastle and the surrounding 20-mile radius.
      </p>
    </div>
  </section>

  <div class="breadcrumb">
    <div class="inner"><a href="/">Home</a> &rsaquo; <span>About</span></div>
  </div>

  <section>
    <div class="body-content">
      <h2>Independent, named, local</h2>
      <p>Most of the bigger oven cleaning names in Newcastle are national franchises — each local territory run by a salaried franchisee operating to a national template. That's a fine model for them, but it isn't what I do. I'm an independent sole trader. I quote the job, I do the job, I clean up after the job, and I'm the one who picks up the phone if you ever need to call about it again. Same person, every time.</p>

      <h2>What I clean</h2>
      <p>Specialist oven cleaning only. Not general domestic cleaning, not commercial cleaning, not carpets. The full list:</p>
      <ul>
        <li>Single and double ovens</li>
        <li>Range cookers — Rangemaster, Stoves, Belling, Smeg, Lacanche, Falcon, etc.</li>
        <li>Hobs — gas, electric, ceramic, induction</li>
        <li>Extractor fans and cooker hoods</li>
        <li>Microwaves (built-in, freestanding, combi)</li>
      </ul>

      <h2>Insurance</h2>
      <p>Fully insured via <strong>Simply Business</strong> — £1m public liability, policy CHBS5491775XB, valid April 2026 to April 2027. Certificate available on request — happy to email a copy before the visit if it helps.</p>

      <h2>Where I work</h2>
      <p>Within roughly 20 miles of Fenham. The <a href="/#areas">full area list</a> is on the homepage — Jesmond, Gosforth, High Heaton, Newcastle Great Park, Ponteland, Darras Hall, Tynemouth, Whitley Bay (Monkseaton end), Cullercoats, Morpeth, Low Fell, Wylam, Ryton, Benton, Wideopen, Killingworth, Prudhoe and the streets around them. If you're not sure, give me a call and I'll tell you straight.</p>

      <h2>Get in touch</h2>
      <p>Call <strong>{NAP.phone.display}</strong>, WhatsApp the same number, or email <a href={NAP.email.href}>{NAP.email.address}</a>. Most enquiries get a same-day reply.</p>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
