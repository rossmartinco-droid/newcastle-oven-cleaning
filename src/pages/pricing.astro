---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LocalBusiness from '~/components/schema/LocalBusiness.astro';
import BreadcrumbList from '~/components/schema/BreadcrumbList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { NAP } from '~/lib/nap';

const title = 'Oven Cleaning Prices Newcastle | Transparent Pricing | Newcastle Oven Cleaning';
const description = 'Transparent oven cleaning prices in Newcastle. Single oven £55, double £80, range cooker £160, hob and microwave £20, extractor £35 as add-ons. Call 07949 529741.';
const url = '/pricing/';
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <LocalBusiness />
    <BreadcrumbList crumbs={[{ name: 'Pricing', url }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow">⭐ Fixed prices · No "from £X" surprises</div>
      <h1>Pricing — <span>Specialist Oven Cleaning</span></h1>
      <p class="hero-lead">
        Fixed prices, not "from £X" anchor prices. Same price regardless of condition. No postcode markup — same prices everywhere I cover.
      </p>
    </div>
  </section>

  <div class="breadcrumb">
    <div class="inner"><a href="/">Home</a> &rsaquo; <span>Pricing</span></div>
  </div>

  <section>
    <div class="body-content">

      <h2>Core appliances</h2>

      <div class="price-box">
        <h3><a href="/single-oven-cleaning-newcastle/">Single oven</a></h3>
        <p class="big">£55</p>
        <p>Full interior clean. Racks, trays, both door panes. 1.5–2 hours on site.</p>
      </div>

      <div class="price-box">
        <h3><a href="/double-oven-cleaning-newcastle/">Double oven</a></h3>
        <p class="big">£80</p>
        <p>Both cavities, all racks, both door panes. 2–3 hours on site.</p>
      </div>

      <div class="price-box">
        <h3><a href="/range-cooker-cleaning-newcastle/">Range cooker</a></h3>
        <p class="big">£160</p>
        <p>All range cookers — Rangemaster, Stoves, Belling, Smeg, Lacanche, Falcon. Hob included. 3–4 hours on site.</p>
      </div>

      <h2>Add-ons (with an oven clean)</h2>

      <div class="price-box">
        <h3><a href="/hob-and-extractor-cleaning-newcastle/">Hob clean</a></h3>
        <p class="big">£20</p>
        <p>Gas, electric, ceramic or induction. Burners dismantled, pan supports cleaned, surface polished.</p>
      </div>

      <div class="price-box">
        <h3><a href="/hob-and-extractor-cleaning-newcastle/">Extractor / cooker hood clean</a></h3>
        <p class="big">£35</p>
        <p>Filters degreased, blades cleaned, internal housing where accessible, exterior canopy polished. The most labour-intensive add-on — fan motors and ducting take longer than hob or microwave work.</p>
      </div>

      <div class="price-box">
        <h3><a href="/microwave-cleaning-newcastle/">Microwave clean</a></h3>
        <p class="big">£20</p>
        <p>Built-in, freestanding, combi. Cavity, ceiling, turntable, door — all surfaces.</p>
      </div>

      <h2>Standalone add-ons (without an oven clean)</h2>
      <p>Standalone hob-only or microwave-only visits are £30 because they involve a separate trip. Standalone extractor-only visits £50. Most customers bundle them with an oven clean to keep the total down.</p>

      <h2>Common combined visits</h2>
      <ul>
        <li>Single oven + hob: £75</li>
        <li>Single oven + hob + extractor: £110</li>
        <li>Double oven + hob + extractor: £135</li>
        <li>Range cooker + extractor: £195</li>
        <li>Full kitchen (oven + hob + extractor + microwave): £130</li>
      </ul>

      <h2>What's not extra</h2>
      <ul>
        <li>No call-out fee</li>
        <li>No travel surcharge — same prices for Jesmond as for Morpeth</li>
        <li>No weekend premium</li>
        <li>No "deep clean" upcharge — every clean is the deep clean</li>
        <li>No tip expected</li>
      </ul>

      <h2>How to get an exact price</h2>
      <p>Call <strong>{NAP.phone.display}</strong> or send 1–3 photos on WhatsApp. For range cookers and any unusual installations, the photo route is fastest — usually a quote within an hour.</p>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
