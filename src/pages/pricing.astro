---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LocalBusiness from '~/components/schema/LocalBusiness.astro';
import BreadcrumbList from '~/components/schema/BreadcrumbList.astro';
import ContactCTA from '~/components/ContactCTA.astro';
import { NAP } from '~/lib/nap';

const title = 'Oven Cleaning Prices Newcastle | Transparent Pricing | Newcastle Oven Cleaning';
const description = 'Transparent oven cleaning prices in Newcastle. Single oven £55–80, double £75–100, range cooker £90–170, hob/extractor/microwave £20 each as add-ons. Call 07949 529741.';
const url = '/pricing/';
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <LocalBusiness />
    <BreadcrumbList crumbs={[{ name: 'Pricing', url }]} />
  </Fragment>

  <section class="hero">
    <div class="container">
      <div class="hero-eyebrow">⭐ Transparent £ ranges · No "from £X" surprises</div>
      <h1>Pricing — <span>Specialist Oven Cleaning</span></h1>
      <p class="hero-lead">
        Real £ ranges, not "from £X" anchor prices. Final price is confirmed by phone or photo before booking. No postcode markup — same prices everywhere I cover.
      </p>
    </div>
  </section>

  <div class="breadcrumb">
    <div class="inner"><a href="/">Home</a> &rsaquo; <span>Pricing</span></div>
  </div>

  <section>
    <div class="body-content">

      <h2>Core appliances</h2>

      <div class="price-box">
        <h3><a href="/single-oven-cleaning-newcastle/">Single oven</a></h3>
        <p class="big">£55–80</p>
        <p>Lower end: well-maintained annual clean. Upper end: hasn't been done in years, heavy build-up, deep dismantling. 1.5–2 hours on site.</p>
      </div>

      <div class="price-box">
        <h3><a href="/double-oven-cleaning-newcastle/">Double oven</a></h3>
        <p class="big">£75–100</p>
        <p>Both cavities, all racks, both door panes. Tall integrated housing with combi grill sits at the upper end. 2–3 hours on site.</p>
      </div>

      <div class="price-box">
        <h3><a href="/range-cooker-cleaning-newcastle/">Range cooker</a></h3>
        <p class="big">£90–170</p>
        <p>Standard 90cm Rangemaster/Stoves/Belling: £90–110. Larger 110cm/120cm: £110–140. Premium continental (Lacanche, Falcon, Wolf): £140–170, quoted from photos. Hob included. 3–4.5 hours.</p>
        <p><strong>Aga cookers — not serviced.</strong> Call for a specialist recommendation.</p>
      </div>

      <h2>Add-ons (with an oven clean)</h2>

      <div class="price-box">
        <h3><a href="/hob-and-extractor-cleaning-newcastle/">Hob clean</a></h3>
        <p class="big">£20</p>
        <p>Gas, electric, ceramic or induction. Burners dismantled, pan supports cleaned, surface polished.</p>
      </div>

      <div class="price-box">
        <h3><a href="/hob-and-extractor-cleaning-newcastle/">Extractor / cooker hood clean</a></h3>
        <p class="big">£20</p>
        <p>Filters degreased, blades cleaned, internal housing where accessible, exterior canopy polished.</p>
      </div>

      <div class="price-box">
        <h3><a href="/microwave-cleaning-newcastle/">Microwave clean</a></h3>
        <p class="big">£20</p>
        <p>Built-in, freestanding, combi. Cavity, ceiling, turntable, door — all surfaces.</p>
      </div>

      <h2>Standalone add-ons (without an oven clean)</h2>
      <p>Hob-only, extractor-only, or microwave-only visits are quoted individually — typically £30–60 — because they involve a separate trip. Most customers bundle them with an oven clean to keep the total down.</p>

      <h2>Common combined visits</h2>
      <ul>
        <li>Single oven + hob: £75–100</li>
        <li>Single oven + hob + extractor: £95–120</li>
        <li>Double oven + hob + extractor: £115–140</li>
        <li>Range cooker + extractor: £110–190</li>
        <li>Full kitchen (oven + hob + extractor + microwave): £115–160</li>
      </ul>

      <h2>What's not extra</h2>
      <ul>
        <li>No call-out fee</li>
        <li>No travel surcharge — same prices for Jesmond as for Morpeth</li>
        <li>No weekend premium (Saturday is standard)</li>
        <li>No "deep clean" upcharge — every clean is the deep clean</li>
        <li>No tip expected</li>
      </ul>

      <h2>How to get an exact price</h2>
      <p>Call <strong>{NAP.phone.display}</strong> or send 1–3 photos on WhatsApp. For range cookers and any unusual installations, the photo route is fastest — usually a quote within an hour.</p>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
